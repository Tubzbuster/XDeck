{
  "name": "xdeck",
  "productName": "XDeck",
  "version": "0.1.0",
  "description": "A Steam Deck native, controller-first Xbox 360-style dashboard for Xbox Game Pass: cloud streaming plus local launching through Proton.",
  "main": "src/main/main.js",
  "private": true,
  "license": "MIT",
  "author": "tubzbuster and XDeck contributors",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --windowed --devtools",
    "test": "node --test \"test/*.test.js\"",
    "lint:sh": "shellcheck scripts/*.sh",
    "dist": "electron-builder --linux AppImage --x64",
    "dist:dir": "electron-builder --linux dir --x64"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
