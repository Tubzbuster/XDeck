{
  "market": "US",
  "language": "en-us",

  "ui": {
    "theme": "xbox360-metro",
    "startPivot": "home",
    "sounds": true,
    "fullscreen": true
  },

  "catalog": {
    "cloudListId": "29a81209-df6f-41fd-a528-2ae6b91f719c",
    "pcListId": "fdd9e2a7-0fee-49f6-ad69-4354098401ff",
    "cloudLimit": 1000,
    "pcLimit": 1000,
    "cacheHours": 12
  },

  "cloud": {
    "enabled": true,
    "baseUrl": "https://www.xbox.com",
    "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36 Edg/130.0.0.0"
  },

  "local": {
    "enabled": true,
    "libraryDirs": [
      "~/XboxGames",
      "/run/media/*/XboxGames",
      "/run/media/deck/*/XboxGames"
    ],
    "proton": {
      "preferUmu": true,
      "umuPath": null,
      "protonPath": null,
      "prefixMode": "per-game",
      "extraEnv": {
        "PROTON_ENABLE_NVAPI": "0",
        "DXVK_ASYNC": "1"
      }
    }
  },

  "import": {
    "internalDir": "~/XboxGames",
    "sdFolderName": "XboxGames",
    "mountRoots": ["/run/media", "/media", "/mnt"],
    "extraSources": [],
    "freeSpaceMarginGB": 2
  }
}
